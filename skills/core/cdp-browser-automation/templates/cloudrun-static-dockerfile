# MindCoach Pro — Docker (Cloud Run)
# Static site served by nginx:alpine on Cloud Run
# Build: gcloud builds submit --tag REGISTRY/IMAGE --project=PROJECT
# Deploy: gcloud run deploy SERVICE --image REGISTRY/IMAGE --allow-unauthenticated --port 8080
FROM nginx:alpine
COPY . /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
